<?xml version="1.0" encoding="utf-8"?>
<!-- Compact widget for small sizes: album art + title + play/next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_art_bg"
        android:contentDescription="Album art"
        android:padding="2dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_art" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Nothing playing"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/widget_play"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@android:color/transparent"
        android:contentDescription="Play or pause"
        android:scaleType="center"
        android:src="@drawable/ic_widget_play" />

    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@android:color/transparent"
        android:contentDescription="Next"
        android:scaleType="center"
        android:src="@drawable/ic_widget_next" />
</LinearLayout>
